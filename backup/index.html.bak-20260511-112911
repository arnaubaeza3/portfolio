<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"/>
<meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)"/>
<title>Arnau Baeza Muñoz — Portfolio</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%231d1d1f'/%3E%3Ctext x='16' y='22' font-family='Georgia%2C serif' font-size='14' font-weight='500' fill='white' text-anchor='middle' letter-spacing='-0.5'%3EAB%3C/text%3E%3C/svg%3E"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="preload" as="image" href="images/tu-foto-720.webp" imagesrcset="images/tu-foto-720.webp 720w, images/tu-foto-1440.webp 1440w" imagesizes="(max-width: 960px) 70vw, 380px"/>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --serif: 'Fraunces', 'Playfair Display', Georgia, serif;
  --sans:  'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --nav-h: 64px;
  --gap:   140px;
  --r:     18px;
  --maxw:  1280px;
  --ease:  cubic-bezier(0.22, 1, 0.36, 1);
  --pop:   cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ── Light theme ── */
:root[data-theme="light"] {
  --bg:        #ffffff;
  --bg-soft:   #f5f5f7;
  --bg-inv:    #0a0a0c;
  --surface:   #ffffff;
  --border:    #e6e6ea;
  --border-2:  #d1d1d6;
  --text:      #0a0a0c;
  --text-1:    #1d1d1f;
  --text-2:    #4b4b50;
  --text-3:    #8e8e93;
  --text-4:    #c7c7cc;
  --accent:    #b8843d;
  --accent-2:  #e8c690;
  --accent-soft: rgba(184, 132, 61, 0.10);
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow:    0 8px 28px rgba(0,0,0,0.08);
  --shadow-lg: 0 32px 80px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.06);
  --nav-bg:    rgba(255, 255, 255, 0.78);
  --grid-line: rgba(0, 0, 0, 0.045);
}

/* ── Dark theme ── */
:root[data-theme="dark"] {
  --bg:        #0a0a0c;
  --bg-soft:   #131317;
  --bg-inv:    #f5f5f7;
  --surface:   #16161b;
  --border:    #26262d;
  --border-2:  #3a3a42;
  --text:      #f5f5f7;
  --text-1:    #f5f5f7;
  --text-2:    #c1c1c8;
  --text-3:    #8e8e93;
  --text-4:    #4b4b50;
  --accent:    #e8c690;
  --accent-2:  #c8a165;
  --accent-soft: rgba(232, 198, 144, 0.10);
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.4);
  --shadow:    0 8px 28px rgba(0,0,0,0.45);
  --shadow-lg: 0 32px 80px rgba(0,0,0,0.55), 0 4px 16px rgba(0,0,0,0.35);
  --nav-bg:    rgba(10, 10, 12, 0.72);
  --grid-line: rgba(255, 255, 255, 0.04);
}

html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

body {
  font-family: var(--sans);
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  transition: background 0.3s var(--ease), color 0.3s var(--ease);
}

::selection { background: var(--accent); color: var(--bg); }

a { color: inherit; }

/* Skip-link */
.skip {
  position: absolute; top: -40px; left: 12px; z-index: 200;
  background: var(--bg-inv); color: var(--bg); padding: 8px 14px;
  border-radius: 8px; font-size: 13px; text-decoration: none;
}
.skip:focus { top: 12px; }

/* ── Nav ── */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  height: var(--nav-h); z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  background: var(--nav-bg);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--border);
  transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
}
.nav-logo {
  font-family: var(--serif);
  font-size: 18px; font-weight: 500;
  color: var(--text); text-decoration: none; letter-spacing: -0.02em;
  display: inline-flex; align-items: center; gap: 10px;
}
.nav-logo::before {
  content: ''; width: 8px; height: 8px; border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 12px var(--accent);
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{ opacity: 1; transform: scale(1); } 50%{ opacity: 0.6; transform: scale(0.85); } }

.nav-right { display: flex; align-items: center; gap: 24px; }
.nav-links { display: flex; align-items: center; gap: 28px; list-style: none; }
.nav-links a {
  font-size: 13.5px; font-weight: 500; color: var(--text-3);
  text-decoration: none; letter-spacing: -0.01em;
  position: relative; padding: 6px 2px;
  transition: color 0.2s var(--ease);
}
.nav-links a:hover { color: var(--text); }
.nav-links a::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: -2px;
  height: 1px; background: var(--accent);
  transform: scaleX(0); transform-origin: left;
  transition: transform 0.35s var(--ease);
}
.nav-links a.active { color: var(--text); }
.nav-links a.active::after { transform: scaleX(1); }

/* Theme toggle */
.theme-toggle {
  width: 36px; height: 36px; border-radius: 50%;
  background: transparent; border: 1px solid var(--border);
  color: var(--text-2); cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
  transition: border-color 0.2s, transform 0.3s var(--pop), color 0.2s, background 0.2s;
}
.theme-toggle:hover { border-color: var(--text-2); color: var(--text); transform: rotate(15deg); }
.theme-toggle svg { width: 16px; height: 16px; }
:root[data-theme="light"] .icon-moon { display: block; }
:root[data-theme="light"] .icon-sun  { display: none; }
:root[data-theme="dark"]  .icon-moon { display: none; }
:root[data-theme="dark"]  .icon-sun  { display: block; }

/* Hamburger */
.hamb {
  display: none;
  width: 36px; height: 36px; border: 1px solid var(--border);
  border-radius: 50%; background: transparent; cursor: pointer;
  position: relative;
}
.hamb span {
  position: absolute; left: 50%; top: 50%;
  width: 14px; height: 1.5px; background: var(--text);
  transform: translate(-50%, -50%);
  transition: transform 0.3s var(--ease), opacity 0.2s;
}
.hamb span:nth-child(1) { transform: translate(-50%, calc(-50% - 4px)); }
.hamb span:nth-child(3) { transform: translate(-50%, calc(-50% + 4px)); }
body.menu-open .hamb span:nth-child(1) { transform: translate(-50%, -50%) rotate(45deg); }
body.menu-open .hamb span:nth-child(2) { opacity: 0; }
body.menu-open .hamb span:nth-child(3) { transform: translate(-50%, -50%) rotate(-45deg); }

/* Mobile drawer */
.drawer {
  position: fixed; inset: var(--nav-h) 0 0 0; z-index: 99;
  background: var(--bg);
  display: flex; flex-direction: column;
  padding: 40px 32px; gap: 4px;
  transform: translateX(100%);
  transition: transform 0.4s var(--ease);
  overflow-y: auto;
}
body.menu-open .drawer { transform: translateX(0); }
.drawer a {
  font-family: var(--serif); font-size: 32px; font-weight: 400;
  color: var(--text); text-decoration: none;
  padding: 18px 0; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  letter-spacing: -0.02em;
}
.drawer a span.num {
  font-family: var(--sans); font-size: 11px; color: var(--text-3);
  font-weight: 500; letter-spacing: 0.1em;
}
.drawer-cta { margin-top: 28px; display: flex; gap: 10px; flex-wrap: wrap; }

/* ── Buttons ── */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 22px; border-radius: 980px;
  font-family: var(--sans); font-size: 14px; font-weight: 500;
  text-decoration: none; cursor: pointer;
  border: 1px solid transparent; letter-spacing: -0.01em;
  transition: transform 0.2s var(--ease), box-shadow 0.2s, background 0.2s, border-color 0.2s, color 0.2s;
}
.btn-primary  { background: var(--text); color: var(--bg); }
.btn-primary:hover  { transform: translateY(-2px); box-shadow: var(--shadow); }
.btn-secondary { background: transparent; color: var(--text); border-color: var(--border-2); }
.btn-secondary:hover { border-color: var(--text); transform: translateY(-2px); }
.btn-accent { background: var(--accent); color: #0a0a0c; }
.btn-accent:hover { transform: translateY(-2px); box-shadow: 0 8px 24px var(--accent-soft); }
.btn-ghost { background: transparent; color: rgba(255,255,255,0.92); border-color: rgba(255,255,255,0.22); }
.btn-ghost:hover { border-color: rgba(255,255,255,0.6); transform: translateY(-2px); }
.btn svg { width: 14px; height: 14px; }

/* ── Hero ── */
#hero {
  min-height: 100vh;
  display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center;
  padding: calc(var(--nav-h) + 80px) 80px 100px;
  gap: 80px;
  background: var(--bg); position: relative; overflow: hidden;
}
#hero::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    linear-gradient(var(--grid-line) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
  background-size: 80px 80px;
  background-position: -1px -1px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, black 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 40%, black 30%, transparent 75%);
}
#hero::after {
  content: ''; position: absolute;
  width: 600px; height: 600px;
  top: 50%; right: -200px; transform: translateY(-50%);
  background: radial-gradient(circle at center, var(--accent-soft) 0%, transparent 60%);
  pointer-events: none; z-index: 0;
}

.hero-text { position: relative; z-index: 1; }
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 11.5px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--text-3); margin-bottom: 32px;
  opacity: 0; animation: fadeUp 0.6s 0.1s var(--ease) forwards;
}
.hero-eyebrow .live-dot {
  width: 7px; height: 7px; border-radius: 50%; background: #22c55e;
  box-shadow: 0 0 10px #22c55e; animation: pulse 1.8s ease-in-out infinite;
}
.hero-eyebrow .sep { width: 24px; height: 1px; background: var(--border-2); }

.hero-name {
  font-family: var(--serif);
  font-size: clamp(48px, 7vw, 96px);
  font-weight: 400; font-variation-settings: 'opsz' 144;
  line-height: 0.96; letter-spacing: -0.04em;
  color: var(--text-1); margin-bottom: 18px;
  opacity: 0; animation: fadeUp 0.7s 0.18s var(--ease) forwards;
}
.hero-name em {
  font-style: italic; font-weight: 300; color: var(--accent);
  font-variation-settings: 'opsz' 144;
}

.hero-title {
  font-family: var(--sans); font-size: clamp(15px, 1.4vw, 18px);
  font-weight: 400; color: var(--text-2); margin-bottom: 28px;
  letter-spacing: -0.005em;
  opacity: 0; animation: fadeUp 0.7s 0.28s var(--ease) forwards;
}
.hero-title strong { font-weight: 600; color: var(--text); }

.hero-desc {
  font-size: 17px; font-weight: 400; line-height: 1.6; color: var(--text-2);
  max-width: 480px; margin-bottom: 44px;
  opacity: 0; animation: fadeUp 0.7s 0.36s var(--ease) forwards;
}

.hero-ctas {
  display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 56px;
  opacity: 0; animation: fadeUp 0.7s 0.44s var(--ease) forwards;
}

.hero-stats {
  display: flex; gap: 40px;
  opacity: 0; animation: fadeUp 0.7s 0.55s var(--ease) forwards;
}
.hero-stat .num {
  font-family: var(--serif); font-size: 28px; font-weight: 400;
  color: var(--text-1); letter-spacing: -0.02em; line-height: 1;
  display: block; margin-bottom: 4px;
}
.hero-stat .num em { font-style: italic; color: var(--accent); }
.hero-stat .lbl {
  font-size: 11.5px; font-weight: 500; color: var(--text-3);
  text-transform: uppercase; letter-spacing: 0.1em;
}

/* Photo */
.hero-photo-wrap {
  position: relative; z-index: 1;
  display: flex; justify-content: center; align-items: center;
  opacity: 0; animation: fadeIn 0.9s 0.45s var(--ease) forwards;
}
.hero-photo-frame {
  position: relative;
  width: min(380px, 100%); aspect-ratio: 4/5;
  border-radius: 24px; background: var(--bg-soft); overflow: hidden;
  box-shadow: var(--shadow-lg);
  transform: rotate(-2deg);
  transition: transform 0.6s var(--ease);
}
.hero-photo-frame:hover { transform: rotate(0); }
.hero-photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
.hero-photo-frame::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, transparent 60%, rgba(0,0,0,0.18));
  pointer-events: none;
}

/* Floating cards around photo */
.hero-card {
  position: absolute; background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px; padding: 12px 16px;
  font-size: 12.5px; font-weight: 500; color: var(--text);
  box-shadow: var(--shadow);
  display: inline-flex; align-items: center; gap: 8px;
  white-space: nowrap;
  backdrop-filter: blur(10px);
}
.hero-card .ico { width: 16px; height: 16px; }
.hero-card.c-1 { top: 8%; right: -28px; animation: float 5s ease-in-out infinite; }
.hero-card.c-2 { bottom: 18%; left: -36px; animation: float 5s ease-in-out 1.6s infinite; }
.hero-card.c-3 {
  bottom: -14px; right: 24px;
  animation: float 5s ease-in-out 0.8s infinite;
  background: var(--text); color: var(--bg); border-color: var(--text);
}
@keyframes float { 0%,100%{transform: translateY(0)} 50%{transform: translateY(-10px)} }
@keyframes fadeUp { from{opacity:0; transform: translateY(24px)} to{opacity:1; transform: translateY(0)} }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }

.scroll-hint {
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  color: var(--text-3); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
  z-index: 2; opacity: 0; animation: fadeIn 1s 1.4s forwards;
}
.scroll-hint::after {
  content: ''; width: 1px; height: 36px;
  background: linear-gradient(var(--text-3), transparent);
  animation: scrollLine 2.2s ease-in-out infinite;
}
@keyframes scrollLine { 0%,100%{ transform: scaleY(1); transform-origin: top; opacity: 0.6; } 50%{ transform: scaleY(0.4); transform-origin: bottom; opacity: 0.2; } }

/* ── Sections ── */
section { padding: var(--gap) 80px; max-width: var(--maxw); margin: 0 auto; }
.section-head { display: flex; flex-direction: column; margin-bottom: 64px; }
.section-label {
  font-size: 11.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 14px;
  display: inline-flex; align-items: center; gap: 12px; align-self: flex-start;
}
.section-label::before {
  content: ''; width: 22px; height: 1px; background: var(--accent);
}
.section-heading {
  font-family: var(--serif);
  font-size: clamp(32px, 4.2vw, 56px); font-weight: 400;
  letter-spacing: -0.025em; color: var(--text-1); line-height: 1.1;
  max-width: 800px;
}
.section-heading em { font-style: italic; color: var(--text-3); font-weight: 300; }

/* ── About ── */
#about { background: var(--bg); position: relative; }
.about-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 100px; align-items: start; }
.about-intro {
  font-family: var(--serif);
  font-size: clamp(22px, 2.4vw, 30px); font-weight: 300;
  line-height: 1.4; color: var(--text-1); margin-bottom: 36px;
  letter-spacing: -0.015em;
}
.about-intro em { font-style: italic; color: var(--accent); }
.about-text {
  font-size: 16px; font-weight: 400; line-height: 1.7;
  color: var(--text-2); margin-bottom: 36px; max-width: 540px;
}
.traits { display: flex; gap: 10px; flex-wrap: wrap; }
.trait {
  padding: 8px 16px; border: 1px solid var(--border-2);
  border-radius: 980px; font-size: 13px; color: var(--text-2);
  font-weight: 500; transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.trait:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

.timeline { display: flex; flex-direction: column; }
.timeline-item {
  display: grid; grid-template-columns: 90px 1fr; gap: 24px;
  padding: 28px 0; border-bottom: 1px solid var(--border);
  position: relative;
}
.timeline-item:first-child { border-top: 1px solid var(--border); }
.timeline-item::before {
  content: ''; position: absolute; left: 78px; top: 36px;
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--bg); border: 1.5px solid var(--accent);
}
.timeline-year {
  font-family: var(--serif); font-size: 18px; font-weight: 500;
  color: var(--text-1); padding-top: 1px; letter-spacing: -0.01em;
}
.timeline-year em { font-style: italic; color: var(--accent); font-weight: 400; }
.timeline-content h4 { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 6px; letter-spacing: -0.01em; }
.timeline-content p  { font-size: 14px; color: var(--text-3); line-height: 1.55; }

/* ── Skills ── */
#skills { background: var(--bg-soft); max-width: none; padding-left: 0; padding-right: 0; }
#skills > * { max-width: var(--maxw); margin-left: auto; margin-right: auto; padding-left: 80px; padding-right: 80px; }
.skills-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
}
.skill-block {
  background: var(--bg); border-radius: var(--r); padding: 32px;
  border: 1px solid var(--border);
  transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
  position: relative; overflow: hidden;
}
.skill-block::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle 200px at var(--mx, 50%) var(--my, 50%), var(--accent-soft), transparent 70%);
  opacity: 0; transition: opacity 0.4s;
  pointer-events: none;
}
.skill-block:hover { transform: translateY(-4px); border-color: var(--border-2); box-shadow: var(--shadow); }
.skill-block:hover::before { opacity: 1; }
.skill-icon {
  width: 40px; height: 40px;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--accent-soft); color: var(--accent);
  border-radius: 12px; margin-bottom: 20px;
}
.skill-icon svg { width: 20px; height: 20px; }
.skill-block h4 {
  font-family: var(--serif); font-size: 19px; font-weight: 500;
  color: var(--text); margin-bottom: 16px; letter-spacing: -0.015em;
}
.skill-tags { display: flex; flex-wrap: wrap; gap: 6px; position: relative; z-index: 1; }
.skill-tag {
  font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 6px;
  background: var(--bg-soft); border: 1px solid var(--border);
  color: var(--text-2);
}

/* ── Projects ── */
#projects { background: var(--bg); }
.projects-list { display: flex; flex-direction: column; gap: 0; }
.project-row {
  display: grid; grid-template-columns: 60px 1fr auto auto; align-items: center; gap: 32px;
  padding: 32px 0; text-decoration: none;
  border-top: 1px solid var(--border);
  transition: padding 0.3s var(--ease);
  position: relative;
}
.project-row:last-child { border-bottom: 1px solid var(--border); }
.project-row::before {
  content: ''; position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: var(--accent-soft); opacity: 0;
  transition: opacity 0.3s;
  margin: 0 -24px; border-radius: 12px;
  pointer-events: none;
}
.project-row:hover::before { opacity: 1; }
.project-row > * { position: relative; z-index: 1; }
.project-row:hover { padding-left: 24px; padding-right: 24px; }
.proj-num {
  font-family: var(--serif); font-size: 14px; color: var(--text-3);
  font-weight: 400; letter-spacing: 0.05em;
}
.proj-info { min-width: 0; }
.proj-name {
  font-family: var(--serif); font-size: clamp(20px, 2vw, 26px);
  font-weight: 500; color: var(--text); margin-bottom: 6px;
  letter-spacing: -0.02em; line-height: 1.2;
}
.proj-desc { font-size: 14.5px; color: var(--text-3); line-height: 1.5; max-width: 520px; }
