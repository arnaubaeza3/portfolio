<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --white:  #ffffff;
  --off:    #f5f5f7;
  --gray-1: #e8e8ed;
  --gray-2: #aeaeb2;
  --gray-3: #6e6e73;
  --gray-4: #3a3a3c;
  --black:  #1d1d1f;
  --ink:    #000000;
  --serif:  'Playfair Display', Georgia, serif;
  --sans:   'DM Sans', -apple-system, sans-serif;
  --nav-h:  56px;
  --gap:    120px;
  --r:      18px;
}

html { scroll-behavior: smooth; }

body {
  font-family: var(--sans);
  background: var(--white);
  color: var(--black);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* ── Nav ── */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  height: var(--nav-h); z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  background: rgba(255,255,255,0.88);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid var(--gray-1);
}
.nav-logo {
  font-family: var(--serif); font-size: 17px; font-weight: 500;
  color: var(--black); text-decoration: none; letter-spacing: -0.01em;
}
.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; }
.nav-links a { font-size: 13px; color: var(--gray-3); text-decoration: none; transition: color 0.2s; }
.nav-links a:hover { color: var(--black); }



/* ── Buttons ── */
.btn {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 11px 22px; border-radius: 980px; font-size: 14px; font-weight: 500;
  text-decoration: none; transition: transform 0.2s, box-shadow 0.2s, background 0.2s, border-color 0.2s;
  cursor: pointer; border: 1px solid transparent;
}
.btn-primary  { background: var(--black); color: var(--white); }
.btn-primary:hover  { background: var(--gray-4); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.18); }
.btn-secondary { background: transparent; color: var(--black); border-color: var(--gray-2); }
.btn-secondary:hover { border-color: var(--black); transform: translateY(-1px); }
.btn-white { background: var(--white); color: var(--black); }
.btn-white:hover { background: var(--off); transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--white); border-color: rgba(255,255,255,0.25); }
.btn-ghost:hover { border-color: rgba(255,255,255,0.6); transform: translateY(-1px); }

/* ── Hero ── */
#hero {
  min-height: 100vh;
  display: grid; grid-template-columns: 1fr 1fr; align-items: center;
  padding: calc(var(--nav-h) + 60px) 80px 80px; gap: 60px;
  background: var(--white); position: relative; overflow: hidden;
}
#hero::before {
  content: ''; position: absolute; inset: 0;
  background-image: linear-gradient(var(--gray-1) 1px, transparent 1px), linear-gradient(90deg, var(--gray-1) 1px, transparent 1px);
  background-size: 60px 60px; opacity: 0.35; pointer-events: none;
}
#hero::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 200px;
  background: linear-gradient(transparent, var(--white)); pointer-events: none;
}
.hero-text { position: relative; z-index: 1; }
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--gray-3); margin-bottom: 28px;
  opacity: 0; animation: fadeUp 0.6s 0.1s cubic-bezier(0.22,1,0.36,1) forwards;
}
.hero-eyebrow::before { content: ''; display: block; width: 20px; height: 1px; background: var(--gray-3); }
.hero-name {
  font-family: var(--serif); font-size: clamp(40px, 5vw, 68px); font-weight: 400;
  line-height: 1.08; letter-spacing: -0.03em; color: var(--ink); margin-bottom: 10px;
  opacity: 0; animation: fadeUp 0.7s 0.2s cubic-bezier(0.22,1,0.36,1) forwards;
}
.hero-title {
  font-family: var(--serif); font-style: italic; font-size: clamp(18px, 2.5vw, 34px);
  font-weight: 400; color: var(--gray-3); margin-bottom: 28px;
  opacity: 0; animation: fadeUp 0.7s 0.3s cubic-bezier(0.22,1,0.36,1) forwards;
}
.hero-desc {
  font-size: 16px; font-weight: 300; line-height: 1.7; color: var(--gray-3);
  max-width: 420px; margin-bottom: 44px;
  opacity: 0; animation: fadeUp 0.7s 0.4s cubic-bezier(0.22,1,0.36,1) forwards;
}
.hero-ctas {
  display: flex; flex-wrap: wrap; gap: 12px;
  opacity: 0; animation: fadeUp 0.7s 0.5s cubic-bezier(0.22,1,0.36,1) forwards;
}
.hero-photo-wrap {
  position: relative; z-index: 1;
  display: flex; justify-content: center; align-items: center;
  opacity: 0; animation: fadeIn 0.9s 0.5s cubic-bezier(0.22,1,0.36,1) forwards;
}
.hero-photo-frame {
  width: 340px; height: 400px; border-radius: 28px; background: var(--gray-1); overflow: hidden;
  box-shadow: 0 32px 80px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.06);
}
.hero-photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
.hero-chip {
  position: absolute; background: var(--white); border: 1px solid var(--gray-1);
  border-radius: 980px; padding: 8px 16px; font-size: 12px; font-weight: 500;
  color: var(--gray-4); box-shadow: 0 4px 16px rgba(0,0,0,0.08); white-space: nowrap;
}
.chip-1 { top: 30px;    right: -30px; animation: float 4s ease-in-out infinite; }
.chip-2 { bottom: 60px; left: -40px;  animation: float 4s ease-in-out 1.5s infinite; }
.chip-3 { bottom: 20px; right: -20px; animation: float 4s ease-in-out 0.8s infinite; }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
.scroll-hint {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  color: var(--gray-2); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  z-index: 2; opacity: 0; animation: fadeIn 1s 1.2s forwards;
}
.scroll-mouse {
  width: 22px; height: 34px; border: 1.5px solid var(--gray-2); border-radius: 11px;
  display: flex; justify-content: center; padding-top: 6px;
}
.scroll-mouse::after {
  content: ''; width: 3px; height: 6px; background: var(--gray-2); border-radius: 2px;
  animation: scrollDot 2s ease-in-out infinite;
}
@keyframes scrollDot { 0%,100%{transform:translateY(0);opacity:1} 80%{transform:translateY(10px);opacity:0} }

/* ── Sections ── */
section { padding: var(--gap) 80px; }
.section-label {
  font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--gray-2); margin-bottom: 16px;
}
.section-heading {
  font-family: var(--serif); font-size: clamp(28px, 3.5vw, 46px); font-weight: 400;
  letter-spacing: -0.02em; color: var(--ink); line-height: 1.15; margin-bottom: 56px;
}
.section-heading em { font-style: italic; color: var(--gray-3); }

/* ── About ── */
#about { background: var(--off); }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
.about-intro { font-size: 20px; font-weight: 300; line-height: 1.65; color: var(--gray-4); margin-bottom: 40px; }
.about-intro strong { font-weight: 600; color: var(--black); }
.traits { display: flex; gap: 12px; flex-wrap: wrap; }
.trait { padding: 7px 16px; border: 1px solid var(--gray-2); border-radius: 980px; font-size: 13px; color: var(--gray-4); }
.timeline { display: flex; flex-direction: column; }
.timeline-item { display: grid; grid-template-columns: 80px 1fr; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--gray-1); }
.timeline-item:first-child { border-top: 1px solid var(--gray-1); }
.timeline-year { font-size: 12px; font-weight: 500; color: var(--gray-2); padding-top: 3px; letter-spacing: 0.03em; }
.timeline-content h4 { font-size: 15px; font-weight: 600; color: var(--black); margin-bottom: 4px; }
.timeline-content p  { font-size: 13.5px; color: var(--gray-3); line-height: 1.5; }

/* ── Skills ── */
#skills { background: var(--white); }
.skills-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.skill-block {
  background: var(--off); border-radius: var(--r); padding: 28px;
  border: 1px solid var(--gray-1);
  transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s;
}
.skill-block:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
.skill-icon { font-size: 26px; margin-bottom: 16px; }
.skill-block h4 { font-size: 14px; font-weight: 600; color: var(--black); margin-bottom: 12px; }
.skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.skill-tag {
  font-size: 11.5px; font-weight: 500; padding: 3px 10px; border-radius: 6px;
  background: var(--white); border: 1px solid var(--gray-1); color: var(--gray-4);
}

/* ── Projects ── */
#projects { background: var(--off); }
.projects-list {
  display: flex; flex-direction: column; gap: 1px;
  background: var(--gray-1); border-radius: var(--r); overflow: hidden;
}
.project-row {
  background: var(--white);
  display: grid; grid-template-columns: 3fr 2fr auto; align-items: center; gap: 32px;
  padding: 28px 32px; text-decoration: none; transition: background 0.2s; cursor: pointer;
}
.project-row:hover { background: var(--off); }
.project-row:first-child { border-radius: var(--r) var(--r) 0 0; }
.project-row:last-child  { border-radius: 0 0 var(--r) var(--r); }
.proj-name  { font-size: 15px; font-weight: 600; color: var(--black); margin-bottom: 5px; }
.proj-desc  { font-size: 13.5px; color: var(--gray-3); line-height: 1.4; }
.proj-tags  { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
.proj-tag   { font-size: 11px; font-weight: 500; padding: 3px 9px; border-radius: 6px; background: var(--off); border: 1px solid var(--gray-1); color: var(--gray-3); }
.proj-arrow { color: var(--gray-2); flex-shrink: 0; transition: transform 0.2s, color 0.2s; }
.project-row:hover .proj-arrow { transform: translateX(4px); color: var(--black); }

/* ── Contact ── */
#contact { background: var(--ink); color: var(--white); text-align: center; padding: 120px 80px; }
#contact .section-label   { color: rgba(255,255,255,0.35); }
#contact .section-heading { color: var(--white); margin-bottom: 16px; }
#contact .section-heading em { color: rgba(255,255,255,0.4); }
.contact-sub {
  font-size: 16px; font-weight: 300; color: rgba(255,255,255,0.5); margin-bottom: 52px;
  max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.6;
}
.contact-ctas { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-bottom: 64px; }
.contact-links { display: flex; justify-content: center; gap: 32px; flex-wrap: wrap; }
.contact-link {
  font-size: 13px; color: rgba(255,255,255,0.4); text-decoration: none;
  transition: color 0.2s; display: flex; align-items: center; gap: 6px;
}
.contact-link:hover { color: var(--white); }

/* ── Footer ── */
footer {
  background: var(--ink); border-top: 1px solid rgba(255,255,255,0.07);
  padding: 28px 80px; display: flex; justify-content: space-between; align-items: center;
}
footer span { font-size: 12px; color: rgba(255,255,255,0.25); }

/* ── Animations ── */
@keyframes fadeUp { from{opacity:0;transform:translateY(22px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
.reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1); }
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }

/* ── Responsive: tablet ── */
@media (max-width: 960px) {
  section { padding: 80px 40px; }
  nav { padding: 0 24px; }
  .nav-links li:not(:last-child) { display: none; }
  #hero {
    grid-template-columns: 1fr;
    padding: calc(var(--nav-h) + 48px) 40px 60px;
    text-align: center;
  }
  .hero-eyebrow { justify-content: center; }
  .hero-desc { margin-left: auto; margin-right: auto; }
  .hero-ctas { justify-content: center; }
  .hero-photo-wrap {
    justify-content: center;
    margin-top: 8px;
  }
  .hero-photo-frame { width: 260px; height: 300px; }
  .chip-1 { right: 0; top: 10px; }
  .chip-2 { left: 0; bottom: 30px; }
  .chip-3 { display: none; }
  .scroll-hint { display: none; }
  .about-grid { grid-template-columns: 1fr; gap: 48px; }
  .about-intro { font-size: 18px; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
  .project-row { grid-template-columns: 1fr auto; gap: 16px; padding: 22px 20px; }
  .proj-tags { display: none; }
  footer { padding: 20px 32px; flex-direction: column; gap: 8px; text-align: center; }
}

/* ── Responsive: mobile ── */
@media (max-width: 560px) {
  :root { --gap: 72px; }
  section { padding: 72px 20px; }
  nav { padding: 0 20px; }
  #hero { padding: calc(var(--nav-h) + 32px) 20px 48px; gap: 32px; }
  .hero-name { font-size: 38px; }
  .hero-title { font-size: 20px; }
  .hero-desc { font-size: 15px; }
  .hero-ctas { flex-direction: column; align-items: center; }
  .hero-ctas .btn { width: 100%; justify-content: center; }
  .hero-photo-frame { width: 220px; height: 260px; border-radius: 20px; }
  .hero-chip { font-size: 11px; padding: 6px 12px; }
  .chip-1 { right: 10px; top: 0; }
  .chip-2 { left: 10px; bottom: 10px; }
  .section-heading { margin-bottom: 36px; }
  .about-intro { font-size: 16px; }
  .skills-grid { grid-template-columns: 1fr; }
  .skill-block { padding: 20px; }
  .project-row { padding: 18px 16px; gap: 12px; }
  .proj-name { font-size: 14px; }
  .proj-desc { font-size: 12.5px; }
  #contact { padding: 72px 20px; }
  .contact-ctas { flex-direction: column; align-items: center; }
  .contact-ctas .btn { width: 100%; justify-content: center; }
  .contact-links { flex-direction: column; align-items: center; gap: 14px; }
  footer { padding: 20px; }
}
</style>
</head>
